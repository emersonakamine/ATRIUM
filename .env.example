# Environment configuration for GuestGate QR / BP Eventos

# Supabase (backend + frontend data layer)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vite expõe ao client (prefixo VITE_ obrigatório)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Base da API backend (vazio = same-origin, ideal p/ dev). No Cloudflare Pages:
# VITE_API_BASE_URL=https://sua-vps.example.com
VITE_API_BASE_URL=

# CORS do backend (domínios do frontend, ou "*")
CORS_ORIGINS=*

# Gemini AI
GEMINI_API_KEY=

# Evolution API (WhatsApp self-hosted)
EVOLUTION_URL=http://localhost:8080
EVOLUTION_INSTANCE=bp-eventos
EVOLUTION_API_KEY=
